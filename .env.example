# Copia este archivo como .env.local y rellena los valores de tu proyecto.
# Supabase → Project Settings → API (o "API Keys").
#
# SOLO la URL y la clave PÚBLICA (publishable / anon) van aquí.
# NUNCA pongas la service_role / secret key en este archivo ni en Vercel
# como variable VITE_*: todo lo que empieza con VITE_ se incluye en el
# JavaScript que descarga el navegador.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
